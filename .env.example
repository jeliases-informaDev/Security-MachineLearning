# TODO ES OPCIONAL: con "docker compose up -d --build" no necesitas este archivo.
#
# Copialo como ".env" en esta carpeta cuando:
#   - corras el ML con uvicorn en tu maquina (lo lee la aplicacion al arrancar), o
#   - quieras cambiar puertos o claves del docker-compose.
# ".env" no se sube a git.

# "dev" permite llamar a la API sin clave interna si INTERNAL_API_KEY esta vacia. En otro entorno es obligatoria.
ENTORNO=dev

# Postgres del docker-compose (docker compose up -d postgres). Despues crea las tablas:  alembic upgrade head
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/security_ml

# Clave compartida con el backend Kotlin (header X-Internal-Key). Debe ser igual a ML_API_KEY del backend.
# Ambos repos usan esta misma por defecto.
INTERNAL_API_KEY=dev-internal-key-change-me

# Origenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:8081

# Indira (agente IA) necesita Ollama con el modelo descargado:  ollama pull llama3.1:8b  (4.9 GB, ~8 GB de RAM).
# Si tu equipo no lo aguanta pon INDIRA_ENABLED=false: Indira responde 503 y el resto funciona igual.
INDIRA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Vigilancia diaria de prensa (ver docs/ARQUITECTURA.md, seccion 3.5).
# En desarrollo conviene NO correrla al arrancar: usa mucha CPU/RAM (consulta Google Noticias y el LLM).
SCRAPING_AL_ARRANCAR=false
# ZONA_HORARIA=America/Lima
# SCRAPING_HORA=6                  # hora a la que corre cada dia
# VIGILANCIA_DIAS=30               # ventana de busqueda por persona
# VIGILANCIA_MAX_POR_PERSONA=6     # noticias maximas por persona y corrida

# ---- Solo para el docker-compose: puertos en tu PC (cambialos si alguno esta ocupado).
# Si cambias POSTGRES_PORT, cambialo tambien en DATABASE_URL.
# ML_PORT=8000
# POSTGRES_PORT=5434

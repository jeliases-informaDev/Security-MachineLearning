# Copia este archivo como ".env" en la raíz del proyecto y completa los valores.
# ".env" no se sube a git.

# "dev" permite llamar a la API sin clave interna. En cualquier otro entorno es obligatoria.
ENTORNO=dev

# Postgres compartido en Aiven (copia host y puerto de la consola; la contraseña se pide al responsable).
# En Aiven el SSL es obligatorio: sslmode=require.
DATABASE_URL=postgresql+psycopg://avnadmin:<contraseña>@<host>:<puerto>/defaultdb?sslmode=require
# Alternativa local: postgresql+psycopg://postgres:postgres@localhost:5432/security_ml

# Clave compartida con el backend Kotlin (header X-Internal-Key). Genera una larga y aleatoria.
INTERNAL_API_KEY=

# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:8081

# Pon false para apagar a Indira (responde 503) si todavía no hay un modelo disponible.
INDIRA_ENABLED=true

# Vigilancia diaria de prensa (ver docs/ARQUITECTURA.md, sección 3.5). Valores por defecto:
# ZONA_HORARIA=America/Lima
# SCRAPING_HORA=6                  # hora a la que corre cada día
# SCRAPING_AL_ARRANCAR=true        # corre al encender si la última corrida fue hace más de 20 h
# VIGILANCIA_DIAS=30               # ventana de búsqueda por persona
# VIGILANCIA_MAX_POR_PERSONA=6     # noticias máximas por persona y corrida

# Modelo local autohospedado para el agente Indira (ver docs/ARQUITECTURA.md).
# Apunta al Ollama compartido del equipo.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
